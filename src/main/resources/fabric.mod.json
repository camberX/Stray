{
	"schemaVersion": 1,
	"id": "stray",
	"version": "${version}",
	"name": "Stray",
	"description": "The most vibecoded professional mod ever",
	"authors": [
		"Stray"
	],
	"contact": {
		"sources": "https://github.com/camberX/Eisenmann"
	},
	"license": "CC0-1.0",
	"custom": {
		"stray:channel": "${channel}",
		"stray:sha": "${sha}"
	},
	"icon": "assets/stray/icon.png",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"dev.stray.update.AutoUpdate"
		],
		"main": [
			"dev.stray.Stray"
		],
		"client": [
			"dev.stray.client.StrayClient"
		]
	},
	"accessWidener": "stray.accesswidener",
	"mixins": [
		{
			"config": "stray.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "stray.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
